rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /announcements/{announcementId} {
      allow read, write: if true;
    }
    match /notes/{noteId} {
      allow read, write: if true;
    }
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }
  }
}
